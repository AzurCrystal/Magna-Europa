    288|add_namespace = wtt_britain_lease_azores
    289|
    290|# England request lease of Azore from POR
    291|country_event = {
    292|	id = wtt_britain_lease_azores.1
    293|	immediate = { log = "[GetDateText]: [Root.GetName]: event wtt_britain_lease_azores.1 FROM = [From.GetName]" }
    294|	title = wtt_britain_lease_azores.1.t
    295|	desc = wtt_britain_lease_azores.1.desc
    296|	picture = GFX_report_event_degaulle_churchill
    297|
    298|	is_triggered_only = yes
    299|	
    300|	#Accept lease
    301|	option = {
    302|		name = wtt_britain_lease_azores.1.a
    303|		ai_chance = {
    304|			base = 10
    305|		}
    306|		FROM = {
    307|			set_country_flag = wtt_britain_lease_azores_accepted
>>  308|			transfer_state = 698
    309|			country_event = { id = wtt_britain_lease_azores.2 }
    310|		}
    311|	}
    312|
    313|	#Never
    314|	option = {
    315|		name = wtt_britain_lease_azores.1.b
    316|		ai_chance = {
    317|			base = 0
    318|		}
    319|		FROM = {
    320|			country_event = { id = wtt_britain_lease_azores.3 }
    321|		}
    322|	}
    323|}
    324|
    325|# Answer from POR - yes
    326|country_event = {
    327|	id = wtt_britain_lease_azores.2
    328|	immediate = { log = "[GetDateText]: [Root.GetName]: event wtt_britain_lease_azores.2 FROM = [From.GetName]" }
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    357|# Was is over - Give control back to POR
    358|country_event = {
    359|	id = wtt_britain_lease_azores.4
