    365|	trigger = {
    366|		has_country_flag = wtt_britain_lease_azores_accepted
    367|		has_war = no
    368|	}
    369|
    370|	mean_time_to_happen = { days = 2 }
    371|
    372|	fire_only_once = yes
    373|	
    374|	option = {
    375|		name = wtt_britain_lease_azores.4.a
    376|		POR = {
>>  377|			transfer_state = 698
    378|			country_event = wtt_britain_lease_azores.5
    379|		}
    380|	}
    381|}
